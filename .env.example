# SQLAlchemy database URL. Defaults to local SQLite if unset.
# Swap to Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/compliance
DATABASE_URL=sqlite:///./compliance.db

# Tier-2 fallback (Phase 3): local Ollama instance + model. Swapping the
# model is a config change, not a code change (e.g. phi3:mini, llama3.1:8b).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
TIER2_CONFIDENCE_THRESHOLD=0.75

# Local vector store for learned patterns (Phase 3/4).
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MATCH_THRESHOLD=0.9
